<Window x:Class="ClipFlyout.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClipFlyout.Controls"
        Title="ClipFlyout へようこそ"
        Width="560"
        Height="690"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Grid Background="{DynamicResource AppSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hero Header -->
        <StackPanel Grid.Row="0" Margin="36,24,36,12" HorizontalAlignment="Center">
            <Image x:Name="WelcomeAppIcon"
                   Width="56" Height="56"
                   Margin="0,0,0,12"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="WelcomeTitle"
                       Text="ClipFlyout へようこそ"
                       FontSize="24"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="WelcomeSubtitle"
                       Text="コピーするだけで、整形・変換・保存のアクションを即座に提案します"
                       FontSize="13"
                       Margin="0,6,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Feature Cards + Quick Setup Options -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,4,36,16">
                <controls:SettingsCard x:Name="CardFeat1" IconGlyph="&#xE8C8;" Header="" Description=""/>
                <controls:SettingsCard x:Name="CardFeat2" IconGlyph="&#xE75B;" Header="" Description=""/>
                <controls:SettingsCard x:Name="CardFeat3" IconGlyph="&#xE72E;" Header="" Description="" Margin="0,0,0,14"/>

                <!-- Quick Language Selector -->
                <controls:SettingsCard x:Name="CardOptLanguage" IconGlyph="&#xF2B7;" Header="" Description="">
                    <ComboBox x:Name="CmbLanguage" Width="170" SelectionChanged="CmbLanguage_SelectionChanged"/>
                </controls:SettingsCard>

                <!-- Quick Startup Toggle -->
                <controls:SettingsCard x:Name="CardOptStartup" IconGlyph="&#xE7E8;" Header="" Description="">
                    <controls:ToggleSwitch x:Name="ToggleStartup"/>
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <Border Grid.Row="2"
                Padding="36,16,36,22"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeBrush}"
                Background="{DynamicResource CardBackgroundSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="BtnCustomize"
                        Style="{StaticResource FluentButtonStyle}"
                        Content="詳細をカスタマイズ"
                        HorizontalAlignment="Left"
                        Height="36"
                        Padding="18,0"
                        Click="BtnCustomize_Click"/>

                <Button Grid.Column="1"
                        x:Name="BtnUseDefaults"
                        Style="{StaticResource FluentAccentButtonStyle}"
                        Content="この設定で始める (推奨)"
                        Height="36"
                        Padding="22,0"
                        Click="BtnUseDefaults_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
