<Window x:Class="ClipFlyout.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClipFlyout.Controls"
        Title="ClipFlyout へようこそ"
        Width="580"
        Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Grid x:Name="RootGrid" Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Hero -->
        <Border Grid.Row="0" Padding="36,32,36,16">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="16" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <Image x:Name="WelcomeAppIcon" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock x:Name="WelcomeTitle"
                           Text="ClipFlyout へようこそ"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#0F172A"/>
                <TextBlock x:Name="WelcomeSubtitle"
                           Text="コピーするだけで、整形・変換・保存のアクションを即座に提案します"
                           FontSize="13"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- Feature Overview Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="36,8,36,12">
            <StackPanel>
                <!-- Feature 1: Clipboard Integration -->
                <Border x:Name="CardFeature1" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Background="#FFFFFF" Padding="16,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="8" Background="#203B82F6" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Feat1Title" Text="クリップボード連携" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock x:Name="Feat1Desc" Text="テキスト、URL、JSON、カラーコード、画像を安全にローカル解析し、操作ボタンを表示" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Feature 2: Taskbar Widget -->
                <Border x:Name="CardFeature2" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Background="#FFFFFF" Padding="16,14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="8" Background="#2010B981" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="📌" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Feat2Title" Text="タスクバーウィジェット" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock x:Name="Feat2Desc" Text="タスクバーに最新のコピー内容を小さく表示。クリックでいつでもフライアウトを呼び出し" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Feature 3: Privacy & Security -->
                <Border x:Name="CardFeature3" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Background="#FFFFFF" Padding="16,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="8" Background="#208B5CF6" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="Feat3Title" Text="プライバシー重視・完全ローカル" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock x:Name="Feat3Desc" Text="外部通信なし。1PasswordやBitwardenなどのパスワード管理ツールは自動除外" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Quick Startup Option Card -->
                <Border x:Name="CardOptionStartup" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Background="#FFFFFF" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="OptStartupTitle" Text="Windows 起動時に自動開始" FontSize="13" FontWeight="Medium" Foreground="#0F172A"/>
                            <TextBlock x:Name="OptStartupDesc" Text="PC起動時にバックグラウンドでスタンバイします" FontSize="11.5" Foreground="#64748B" Margin="0,1,0,0"/>
                        </StackPanel>
                        <controls:ToggleSwitch Grid.Column="1" x:Name="ToggleStartup" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" x:Name="FooterBorder" Padding="36,16,36,24" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0" Background="#F1F5F9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="BtnCustomize"
                        Content="詳細をカスタマイズ"
                        HorizontalAlignment="Left"
                        Height="36"
                        Padding="18,0"
                        Cursor="Hand"
                        Click="BtnCustomize_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="1"
                        x:Name="BtnUseDefaults"
                        Content="既定値で使用する (推奨)"
                        Height="36"
                        Padding="22,0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="BtnUseDefaults_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
