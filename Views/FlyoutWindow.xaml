<Window x:Class="ClipFlyout.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ClipFlyout"
        Width="352"
        MaxWidth="352"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Windows 11 Smooth Easing Entrance Animation -->
        <Storyboard x:Key="ShowStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootTransform"
                             Storyboard.TargetProperty="Y"
                             From="12.0" To="0.0"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="HideStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootCard"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0"
                             Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootTransform"
                             Storyboard.TargetProperty="Y"
                             From="0.0" To="6.0"
                             Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Single Unified Root Card (Strict MaxWidth 352 to guarantee no right-overflow) -->
    <Border x:Name="RootCard"
            CornerRadius="8"
            BorderThickness="1"
            Padding="0"
            Margin="0"
            MaxWidth="352"
            ClipToBounds="True"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTransform" Y="0"/>
        </Border.RenderTransform>

        <!-- Inner Top Highlight Specular Edge -->
        <Border x:Name="InnerHighlightBorder"
                CornerRadius="7"
                BorderThickness="0,1,0,0"
                MaxWidth="352">
            <StackPanel Margin="14,12,14,12" MaxWidth="324">
                <!-- Header: Badge, Title, Subtitle, Close Button -->
                <Grid Margin="0,0,0,8" MaxWidth="324">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Type Badge -->
                    <Border Grid.Column="0"
                            x:Name="TypeBadgeBorder"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                        <TextBlock x:Name="TypeBadgeText"
                                   Text="JSON"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- Title & Subtitle (Constrained with Ellipsis) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="230">
                        <TextBlock x:Name="HeaderTitleText"
                                   Text="JSON Object"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   MaxWidth="230"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="HeaderSubtitleText"
                                   Text="4 properties"
                                   FontSize="11"
                                   MaxWidth="230"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2"
                            x:Name="CloseButton"
                            Width="24" Height="24"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="12">
                                    <TextBlock Text="✕" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#20888888"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Content Preview Area -->
                <Grid x:Name="PreviewArea" Margin="0,0,0,8" MaxWidth="324">
                    <!-- 1. Color Preview -->
                    <Grid x:Name="ColorPreviewPanel" Visibility="Collapsed" MaxWidth="324">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ColorSwatch"
                                Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="#35888888"
                                Background="#3498DB"/>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ColorHexText"
                                       Text="#3498DB"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ColorValuesText"
                                       Text="RGB(52, 152, 219) • HSL(204°, 70%, 53%)"
                                       FontSize="10.5"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 2. Image Preview -->
                    <Grid x:Name="ImagePreviewPanel" Visibility="Collapsed" MaxWidth="324">
                        <Border x:Name="ImagePreviewBorder"
                                CornerRadius="6"
                                BorderThickness="1"
                                MaxHeight="105"
                                ClipToBounds="True">
                            <Image x:Name="ImageThumbnail"
                                   Stretch="Uniform"
                                   MaxHeight="105"
                                   HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- 3. Textual / JSON / Code Preview (Always wraps within 318px) -->
                    <Border x:Name="TextPreviewPanel"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            MaxWidth="324"
                            MaxHeight="84"
                            ClipToBounds="True">
                        <TextBlock x:Name="BodyPreviewText"
                                   Text="{}{...}"
                                   FontFamily="Cascadia Code, Consolas, Segoe UI"
                                   FontSize="11"
                                   MaxWidth="308"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>

                <!-- Actions List OR Inline Feedback (MaxWidth 324 forces WrapPanel to wrap cleanly) -->
                <Grid MinHeight="30" MaxWidth="324">
                    <!-- Actions (WrapPanel strictly bound to 324px max width) -->
                    <ItemsControl x:Name="ActionsItemsControl" MaxWidth="324">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal" MaxWidth="324"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="4,2,0,2"
                                        Height="28"
                                        Padding="10,0"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        ToolTip="{Binding Description}"
                                        Click="ActionButton_Click"
                                        Tag="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           VerticalAlignment="Center"
                                                           Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#25888888"/>
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#45888888"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#40888888"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Inline Feedback -->
                    <Border x:Name="InlineFeedbackBar"
                            Visibility="Collapsed"
                            CornerRadius="4"
                            Height="28"
                            Padding="12,0"
                            MaxWidth="324"
                            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✓" FontWeight="Bold" FontSize="11.5" Margin="0,0,5,0" Foreground="#10B981"/>
                            <TextBlock x:Name="InlineFeedbackText"
                                       Text="コピーしました"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
    </Border>
</Window>
