<Window x:Class="ClipFlyout.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ClipFlyout"
        Width="360"
        MaxWidth="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Windows 11 Smooth Easing Entrance Animation -->
        <Storyboard x:Key="ShowStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootTransform"
                             Storyboard.TargetProperty="Y"
                             From="12.0" To="0.0"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="HideStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootCard"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0"
                             Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RootTransform"
                             Storyboard.TargetProperty="Y"
                             From="0.0" To="6.0"
                             Duration="0:0:0.14">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Single Unified Root Card (CornerRadius="12" matching Windows 11 Fluent) -->
    <Border x:Name="RootCard"
            CornerRadius="12"
            BorderThickness="1"
            Padding="0"
            Margin="0"
            MaxWidth="360"
            ClipToBounds="False"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTransform" Y="0"/>
        </Border.RenderTransform>

        <!-- Inner Top Highlight Specular Edge -->
        <Border x:Name="InnerHighlightBorder"
                CornerRadius="11"
                BorderThickness="0,1,0,0"
                MaxWidth="360">
            <StackPanel Margin="14,12,14,14" MaxWidth="332">
                <!-- Header: Clipboard Icon, App Title, Relative Timestamp, Settings Button, Close Button -->
                <Grid Margin="0,0,0,10" MaxWidth="332">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Icon + Title + Timestamp -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8C8;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="{Binding Foreground, ElementName=HeaderAppName}"/>
                        <TextBlock x:Name="HeaderAppName"
                                   Text="ClipFlyout"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBlock x:Name="TimestampText"
                                   Text="たった今"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Settings & Close Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Settings Button -->
                        <Button x:Name="SettingsButton"
                                Width="26" Height="26"
                                Margin="0,0,3,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="設定"
                                Click="SettingsButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="5">
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#20888888"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#35888888"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Close Button -->
                        <Button x:Name="CloseButton"
                                Width="26" Height="26"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="閉じる"
                                Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="Transparent" CornerRadius="5">
                                        <TextBlock Text="&#xE8BB;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="10.5"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#C42B1C"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Hero Content Preview Card -->
                <Border x:Name="HeroCardBorder"
                        CornerRadius="8"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,0,0,10"
                        MaxWidth="332">
                    <Grid>
                        <!-- 1. Color Preview (Hero Card Layout matching preview.jpg) -->
                        <Grid x:Name="ColorPreviewPanel" Visibility="Collapsed" MaxWidth="308">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ColorSwatch"
                                    Grid.Column="0"
                                    Width="52" Height="52"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="#35888888"
                                    Background="#3B82F6"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ColorHexText"
                                           Text="#3B82F6"
                                           FontSize="17.5"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ColorDescText"
                                           Text="Color Hex Code"
                                           FontSize="11"
                                           Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ColorValuesText"
                                           Text="RGB(59, 130, 246) • HSL(217°, 91%, 60%)"
                                           FontSize="10"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>

                        <!-- 2. Image Preview -->
                        <Grid x:Name="ImagePreviewPanel" Visibility="Collapsed" MaxWidth="308">
                            <Border x:Name="ImagePreviewBorder"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    MaxHeight="120"
                                    ClipToBounds="True">
                                <Image x:Name="ImageThumbnail"
                                       Stretch="Uniform"
                                       MaxHeight="120"
                                       HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                                    <!-- 3. Textual / JSON / Code / URL Preview -->
                        <Border x:Name="TextPreviewPanel"
                                Visibility="Collapsed"
                                CornerRadius="6"
                                BorderThickness="1"
                                Padding="8,6"
                                MaxWidth="308">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border x:Name="TypeBadgeBorder"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0">
                                        <TextBlock x:Name="TypeBadgeText"
                                                   Text="JSON"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock x:Name="HeaderTitleText"
                                               Text="JSON Object"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               MaxWidth="200"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock x:Name="BodyPreviewText"
                                           Text="{}{...}"
                                           FontFamily="Cascadia Code, Consolas, Segoe UI"
                                           FontSize="11"
                                           MaxWidth="290"
                                           MaxHeight="80"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="HeaderSubtitleText"
                                           Text="4 properties"
                                           FontSize="10.5"
                                           Margin="2,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Actions List: Full-Width Vertical Cards -->
                <Grid MaxWidth="332">
                    <ItemsControl x:Name="ActionsItemsControl" MaxWidth="332">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="44"
                                        Margin="0,0,0,6"
                                        Padding="10,6"
                                        BorderThickness="1"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand"
                                        Click="ActionButton_Click"
                                        Loaded="ActionButton_Loaded"
                                        Tag="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Icon Badge / Glyph -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding EffectiveGlyph}"
                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{TemplateBinding Foreground}"/>

                                                    <!-- Title & Subtitle Stack -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DisplaySubtitle}"
                                                                   FontSize="10"
                                                                   Opacity="0.8"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding SubtitleVisibility}"/>
                                                    </StackPanel>

                                                    <!-- Chevron Arrow Glyph -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="&#xE76C;"
                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="10"
                                                               Opacity="0.5"
                                                               VerticalAlignment="Center"
                                                               Margin="4,0,2,0"
                                                               Foreground="{TemplateBinding Foreground}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.88"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Feedback Toast Overlay (shows briefly on action copy/transform) -->
                    <Border x:Name="InlineFeedbackBar"
                            CornerRadius="7"
                            BorderThickness="1"
                            Padding="12,10"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="#10B981"/>
                            <TextBlock x:Name="InlineFeedbackText"
                                       Text="クリップボードにコピーしました"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Recent History Section (Bottom of Flyout matching preview.jpg) -->
                <StackPanel x:Name="RecentHistoryPanel" Margin="0,6,0,0" MaxWidth="332" Visibility="Collapsed">
                    <Separator Height="1" Margin="0,0,0,6" Opacity="0.15"/>
                    <TextBlock x:Name="RecentHeader" Text="履歴" FontSize="10.5" FontWeight="SemiBold" Margin="2,0,0,4" Foreground="#888888"/>
                    <ItemsControl x:Name="RecentHistoryItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="26"
                                        Margin="0,0,0,2"
                                        Padding="6,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        Cursor="Hand"
                                        Click="RecentItem_Click"
                                        Tag="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="histBorder" Background="Transparent" CornerRadius="4" Padding="6,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding IconGlyph}"
                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.85"
                                                               Foreground="{Binding Foreground, ElementName=RecentHeader}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayText}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.95"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding Foreground, ElementName=HeaderAppName}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="histBorder" Property="Background" Value="#18888888"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>
