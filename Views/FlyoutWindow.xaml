<Window x:Class="ClipFlyout.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ClipFlyout"
        Width="356"
        MaxWidth="356"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Action Row Button Style (Zero opacity washout, instant Fluent tokens) -->
        <Style x:Key="FlyoutActionButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Fluent Action Glyph -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding EffectiveGlyph}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14.5"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Foreground="{TemplateBinding Foreground}"/>

                                <!-- Title & Subtitle Stack -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,6,0">
                                    <TextBlock Text="{Binding Label}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{TemplateBinding Foreground}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DisplaySubtitle}"
                                               FontSize="10.5"
                                               Opacity="0.78"
                                               Margin="0,1,0,0"
                                               Foreground="{TemplateBinding Foreground}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding SubtitleVisibility}"/>
                                </StackPanel>

                                <!-- Keyboard Shortcut Pill -->
                                <Border x:Name="ShortcutBadge"
                                        Grid.Column="2"
                                        MinWidth="20"
                                        Height="20"
                                        Padding="5,0"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource ShortcutBadgeBackgroundBrush}"
                                        Visibility="{Binding ShortcutVisibility}">
                                    <TextBlock x:Name="ShortcutText"
                                               Text="{Binding ShortcutHint}"
                                               FontSize="10.5"
                                               FontWeight="Medium"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource ShortcutBadgeForegroundBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource FluentAccentBrush}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource FluentTextOnAccentBrush}"/>
                                <Setter TargetName="ShortcutBadge" Property="Background" Value="#28000000"/>
                                <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource FluentTextOnAccentBrush}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPrimary}" Value="False"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ControlFillHoverBrush}"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeSecondaryBrush}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPrimary}" Value="False"/>
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ControlFillPressedBrush}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPrimary}" Value="True"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource FluentAccentHoverBrush}"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPrimary}" Value="True"/>
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource FluentAccentPressedBrush}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Single Unified Root Card (8px radius matching Win11 DWMWCP_ROUND) -->
    <Border x:Name="RootCard"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource FlyoutStrokeBrush}"
            Background="{DynamicResource FlyoutSurfaceFallbackBrush}"
            Padding="14,12,14,12"
            MaxWidth="356"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <StackPanel>
            <!-- Header: Type Icon, Title, Relative Timestamp, Pin / Search / Settings / Close -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderIconGlyph"
                               Text="&#xE8C8;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0"
                               Foreground="{DynamicResource FluentAccentBrush}"/>
                    <TextBlock x:Name="HeaderAppName"
                               Text="ClipFlyout"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               MaxWidth="140"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TimestampText"
                               Text="たった今"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="7,1,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SaveSnippetButton"
                            Style="{DynamicResource FluentSubtleIconButtonStyle}"
                            Width="26" Height="26"
                            Margin="0,0,2,0"
                            Visibility="Collapsed"
                            Click="SaveSnippetButton_Click">
                        <TextBlock Text="&#xE8A4;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12"/>
                    </Button>

                    <Button x:Name="EditToggleButton"
                            Style="{DynamicResource FluentSubtleIconButtonStyle}"
                            Width="26" Height="26"
                            Margin="0,0,2,0"
                            Visibility="Collapsed"
                            Click="EditToggleButton_Click">
                        <TextBlock Text="&#xE70F;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12"/>
                    </Button>

                    <Button x:Name="PinButton"
                            Style="{DynamicResource FluentSubtleIconButtonStyle}"
                            Width="26" Height="26"
                            Margin="0,0,2,0"
                            Click="PinButton_Click">
                        <TextBlock x:Name="PinButtonGlyph"
                                   Text="&#xE718;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12"/>
                    </Button>

                    <Button x:Name="SearchToggleButton"
                            Style="{DynamicResource FluentSubtleIconButtonStyle}"
                            Width="26" Height="26"
                            Margin="0,0,2,0"
                            Visibility="Collapsed"
                            Click="SearchToggleButton_Click">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12"/>
                    </Button>

                    <Button x:Name="SettingsButton"
                            Style="{DynamicResource FluentSubtleIconButtonStyle}"
                            Width="26" Height="26"
                            Margin="0,0,2,0"
                            Click="SettingsButton_Click">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12"/>
                    </Button>

                    <Button x:Name="CloseButton"
                            Width="26" Height="26"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="Transparent" CornerRadius="4">
                                    <TextBlock Text="&#xE8BB;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#C42B1C"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#A32014"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Unified Single-Layer Hero Content Preview Card (No Box-in-Box!) -->
            <Border x:Name="HeroCardBorder"
                    CornerRadius="6"
                    BorderThickness="1"
                    Background="{DynamicResource FlyoutHeroBackgroundBrush}"
                    BorderBrush="{DynamicResource FlyoutHeroStrokeBrush}"
                    Padding="12,10"
                    Margin="0,0,0,10">
                <Grid>
                    <!-- 1. Color Preview -->
                    <Grid x:Name="ColorPreviewPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ColorSwatch"
                                Grid.Column="0"
                                Width="48" Height="48"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeSecondaryBrush}"
                                Background="#3B82F6"/>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ColorHexText"
                                       Text="#3B82F6"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ColorDescText"
                                       Text="Color Code"
                                       FontSize="11"
                                       Margin="0,1,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ColorValuesText"
                                       Text="rgb(59, 130, 246) • hsl(217, 91%, 60%)"
                                       FontSize="10.5"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <!-- 2. Image Preview -->
                    <Grid x:Name="ImagePreviewPanel" Visibility="Collapsed">
                        <Border x:Name="ImagePreviewBorder"
                                CornerRadius="4"
                                MaxHeight="132"
                                ClipToBounds="True">
                            <Grid>
                                <Image x:Name="ImageThumbnail"
                                       Stretch="Uniform"
                                       MaxHeight="132"
                                       HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Border HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="6"
                                        Padding="6,2"
                                        CornerRadius="4"
                                        Background="#B8181818">
                                    <TextBlock x:Name="ImageMetaBadge"
                                               Text="1920×1080"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 3. Text / JSON / Code / URL / FileDrop / Date / JWT Preview -->
                    <StackPanel x:Name="TextPreviewPanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TypeBadgeBorder"
                                    Grid.Column="0"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                                <TextBlock x:Name="TypeBadgeText"
                                           Text="JSON"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="HeaderTitleText"
                                       Grid.Column="1"
                                       Text="JSON Data"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <TextBlock x:Name="BodyPreviewText"
                                   Text="{}{...}"
                                   FontFamily="Cascadia Code, Consolas, Segoe UI Variable Text, Segoe UI"
                                   FontSize="11.5"
                                   LineHeight="16"
                                   MaxHeight="72"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Opacity="0.92"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock x:Name="HeaderSubtitleText"
                                   Text="4 properties"
                                   FontSize="11"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Inline Quick Edit Panel (Toggled from Header Edit Button) -->
            <Border x:Name="InlineEditPanel"
                    Visibility="Collapsed"
                    Margin="0,0,0,8"
                    Padding="8"
                    CornerRadius="6"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBox x:Name="InlineEditBox"
                             Style="{DynamicResource FluentTextBoxStyle}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Height="68"
                             MaxHeight="120"
                             MinHeight="68"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="12"
                             Padding="8,7"
                             GotKeyboardFocus="InlineEditBox_GotKeyboardFocus"
                             LostKeyboardFocus="InlineEditBox_LostKeyboardFocus"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Right">
                        <Button x:Name="BtnEditSaveSnippet"
                                Style="{DynamicResource FluentButtonStyle}"
                                Height="28"
                                Padding="10,0"
                                FontSize="11.5"
                                Content="定型文保存"
                                Margin="0,0,6,0"
                                Click="BtnEditSaveSnippet_Click"/>
                        <Button x:Name="BtnEditCopy"
                                Style="{DynamicResource FluentButtonStyle}"
                                Height="28"
                                Padding="12,0"
                                FontSize="11.5"
                                Content="コピー"
                                Margin="0,0,6,0"
                                Click="BtnEditCopy_Click"/>
                        <Button x:Name="BtnEditPaste"
                                Style="{DynamicResource FluentAccentButtonStyle}"
                                Height="28"
                                Padding="12,0"
                                FontSize="11.5"
                                Content="貼り付け"
                                Click="BtnEditPaste_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actions List (Scrollable when > 5 actions, Zero-Jump Feedback Overlay) -->
            <Grid>
                <ScrollViewer x:Name="ActionsScrollViewer"
                              MaxHeight="250"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ActionsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource FlyoutActionButtonStyle}"
                                        ToolTip="{Binding Description}"
                                        Click="ActionButton_Click"
                                        Loaded="ActionButton_Loaded"
                                        Tag="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Feedback Toast Overlay (Overlays Hidden ActionsScrollViewer so height never jumps) -->
                <Border x:Name="InlineFeedbackBar"
                        CornerRadius="6"
                        BorderThickness="1"
                        Background="{DynamicResource FlyoutFeedbackBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeBrush}"
                        Padding="14,12"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="InlineFeedbackIcon"
                                   Text="&#xE73E;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource StatusSuccessBrush}"/>
                        <TextBlock x:Name="InlineFeedbackText"
                                   Text="クリップボードにコピーしました"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   MaxWidth="276"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent History & Snippets Segmented Footer Section -->
            <StackPanel x:Name="RecentHistoryPanel" Margin="0,6,0,0" Visibility="Collapsed">
                <Border Height="1" Background="{DynamicResource DividerStrokeBrush}" Margin="0,0,0,7"/>

                <Grid Margin="2,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="TabHistoryButton"
                                Padding="7,2"
                                Margin="0,0,4,0"
                                Background="{DynamicResource SubtleFillHoverBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="TabHistoryButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="RecentHeader"
                                       Text="履歴"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button x:Name="TabSnippetsButton"
                                Padding="7,2"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="TabSnippetsButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock x:Name="SnippetsTabHeader"
                                       Text="定型文"
                                       FontSize="11"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </Button>
                    </StackPanel>
                    <Button x:Name="ClearHistoryButton"
                            Grid.Column="1"
                            Content="クリア"
                            FontSize="10.5"
                            Padding="6,1"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextTertiaryBrush}"
                            Cursor="Hand"
                            Click="ClearHistoryButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="clrBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="clrBorder" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Inline Search Box with Watermark Placeholder (Shown when toggled) -->
                <Grid x:Name="HistorySearchContainer" Visibility="Collapsed" Margin="0,0,0,5">
                    <TextBox x:Name="HistorySearchBox"
                             Style="{DynamicResource FluentTextBoxStyle}"
                             Height="28"
                             MinHeight="28"
                             FontSize="12"
                             Padding="8,0"
                             GotKeyboardFocus="HistorySearchBox_GotKeyboardFocus"
                             LostKeyboardFocus="HistorySearchBox_LostKeyboardFocus"
                             TextChanged="HistorySearchBox_TextChanged"/>
                    <TextBlock x:Name="HistorySearchPlaceholder"
                               Text="履歴を絞り込み..."
                               FontSize="12"
                               Margin="10,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </Grid>

                <TextBlock x:Name="SnippetsEmptyText"
                           Text="定型文はまだありません"
                           FontSize="11.5"
                           Margin="6,4,6,6"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="Collapsed"/>

                <ScrollViewer MaxHeight="116" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RecentHistoryItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="rowBorder" Background="Transparent" CornerRadius="4" Padding="4,2" Margin="0,0,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Height="24"
                                                Padding="2,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Stretch"
                                                Cursor="Hand"
                                                Click="RecentItem_Click"
                                                Tag="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="Transparent">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding IconGlyph}"
                                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DisplayText}"
                                                                   FontSize="11.5"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel x:Name="hoverActions" Orientation="Horizontal" Visibility="Collapsed" Margin="4,0,0,0">
                                                <Button Style="{DynamicResource FluentSubtleIconButtonStyle}"
                                                        Width="22" Height="22"
                                                        Margin="0,0,2,0"
                                                        ToolTip="{Binding QuickPasteTooltip}"
                                                        Click="QuickPasteRowButton_Click"
                                                        Tag="{Binding}">
                                                    <TextBlock Text="&#xE77F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                                                </Button>
                                                <Button Style="{DynamicResource FluentSubtleIconButtonStyle}"
                                                        Width="22" Height="22"
                                                        ToolTip="{Binding QuickDeleteTooltip}"
                                                        Click="QuickDeleteRowButton_Click"
                                                        Tag="{Binding}">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                                                </Button>
                                            </StackPanel>
                                            <TextBlock Text="&#xE718;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="10"
                                                       Margin="4,0,2,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource FluentAccentBrush}"
                                                       Visibility="{Binding PinVisibility}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="rowBorder" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="rowBorder" Property="Background" Value="{DynamicResource SubtleFillHoverBrush}"/>
                                        <Setter TargetName="hoverActions" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
