<Window x:Class="ClipFlyout.Views.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipFlyout Taskbar Widget"
        Width="240"
        Height="32"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Border x:Name="RootPill"
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="#40FFFFFF"
            Background="#A0202028"
            Cursor="Hand"
            MouseLeftButtonUp="RootPill_MouseLeftButtonUp">
        <Border.ContextMenu>
            <ContextMenu x:Name="WidgetContextMenu">
                <MenuItem x:Name="MenuOpenFlyout" Header="フライアウトを開く" Click="MenuOpenFlyout_Click"/>
                <MenuItem x:Name="MenuOpenSettings" Header="設定" Click="MenuOpenSettings_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuHideWidget" Header="タスクバーウィジェットを非表示" Click="MenuHideWidget_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid Margin="10,0,10,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="IconText"
                       Text="📋"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <TextBlock x:Name="ClipPreviewText"
                       Grid.Column="1"
                       Text="(クリップボード空)"
                       FontSize="11.5"
                       FontWeight="Medium"
                       Foreground="#E2E8F0"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
