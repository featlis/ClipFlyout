<Window x:Class="ClipFlyout.Views.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipFlyout Taskbar Widget"
        WindowStartupLocation="Manual"
        Width="172"
        MinWidth="136"
        MaxWidth="228"
        Height="36"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Border x:Name="RootPill"
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="#1A000000"
            Background="#C8FFFFFF"
            Padding="6,0,8,0"
            Cursor="Hand"
            MouseEnter="RootPill_MouseEnter"
            MouseLeave="RootPill_MouseLeave"
            MouseLeftButtonDown="RootPill_MouseLeftButtonDown"
            MouseLeftButtonUp="RootPill_MouseLeftButtonUp">
        <Border.ContextMenu>
            <ContextMenu x:Name="WidgetContextMenu" Style="{DynamicResource FluentContextMenuStyle}">
                <MenuItem x:Name="MenuOpenFlyout" Style="{DynamicResource FluentMenuItemStyle}" Header="フライアウトを開く" Click="MenuOpenFlyout_Click"/>
                <MenuItem x:Name="MenuPosition" Style="{DynamicResource FluentMenuItemStyle}" Header="配置位置">
                    <MenuItem x:Name="MenuPosTrayLeft" Style="{DynamicResource FluentMenuItemStyle}" Header="タスクバー右 (トレイ左隣)" Click="MenuPos_Click" Tag="TrayLeft"/>
                    <MenuItem x:Name="MenuPosCenterRight" Style="{DynamicResource FluentMenuItemStyle}" Header="タスクバー中央・右寄り" Click="MenuPos_Click" Tag="CenterRight"/>
                    <MenuItem x:Name="MenuPosCenterLeft" Style="{DynamicResource FluentMenuItemStyle}" Header="タスクバー中央・左寄り" Click="MenuPos_Click" Tag="CenterLeft"/>
                    <MenuItem x:Name="MenuPosFarLeft" Style="{DynamicResource FluentMenuItemStyle}" Header="タスクバー左端" Click="MenuPos_Click" Tag="FarLeft"/>
                    <MenuItem x:Name="MenuPosAboveTaskbar" Style="{DynamicResource FluentMenuItemStyle}" Header="画面右下 (タスクバー直上)" Click="MenuPos_Click" Tag="AboveTaskbar"/>
                </MenuItem>
                <MenuItem x:Name="MenuAutoAlign" Style="{DynamicResource FluentMenuItemStyle}" Header="トレイ (^) 左隣に自動吸着" IsCheckable="True" Click="MenuAutoAlign_Click"/>
                <MenuItem x:Name="MenuMonitor" Style="{DynamicResource FluentMenuItemStyle}" Header="表示モニター">
                    <MenuItem x:Name="MenuMonPrimary" Style="{DynamicResource FluentMenuItemStyle}" Header="メインモニター" Click="MenuMonitor_Click" Tag="Primary"/>
                    <MenuItem x:Name="MenuMonCursor" Style="{DynamicResource FluentMenuItemStyle}" Header="カーソルのあるモニター" Click="MenuMonitor_Click" Tag="FollowCursor"/>
                    <MenuItem x:Name="MenuMonDisplay1" Style="{DynamicResource FluentMenuItemStyle}" Header="ディスプレイ 1" Click="MenuMonitor_Click" Tag="Monitor1"/>
                    <MenuItem x:Name="MenuMonDisplay2" Style="{DynamicResource FluentMenuItemStyle}" Header="ディスプレイ 2" Click="MenuMonitor_Click" Tag="Monitor2"/>
                    <MenuItem x:Name="MenuMonDisplay3" Style="{DynamicResource FluentMenuItemStyle}" Header="ディスプレイ 3" Click="MenuMonitor_Click" Tag="Monitor3"/>
                </MenuItem>
                <MenuItem x:Name="MenuTextColor" Style="{DynamicResource FluentMenuItemStyle}" Header="文字色">
                    <MenuItem x:Name="MenuTextColorAuto" Style="{DynamicResource FluentMenuItemStyle}" Header="自動 (タスクバー連動)" Click="MenuTextColor_Click" Tag="Auto"/>
                    <MenuItem x:Name="MenuTextColorLight" Style="{DynamicResource FluentMenuItemStyle}" Header="常に白" Click="MenuTextColor_Click" Tag="Light"/>
                    <MenuItem x:Name="MenuTextColorDark" Style="{DynamicResource FluentMenuItemStyle}" Header="常に黒" Click="MenuTextColor_Click" Tag="Dark"/>
                </MenuItem>
                <Separator Style="{DynamicResource FluentMenuSeparatorStyle}"/>
                <MenuItem x:Name="MenuOpenSettings" Style="{DynamicResource FluentMenuItemStyle}" Header="設定..." Click="MenuOpenSettings_Click"/>
                <Separator Style="{DynamicResource FluentMenuSeparatorStyle}"/>
                <MenuItem x:Name="MenuHideWidget" Style="{DynamicResource FluentMenuItemStyle}" Header="タスクバーウィジェットを非表示" Click="MenuHideWidget_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Leading Semantic Type Chip / Color Swatch / Image Thumbnail -->
            <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                <Border x:Name="IconBadge"
                        Width="24" Height="24"
                        CornerRadius="5"
                        Background="#1A0078D4">
                    <TextBlock x:Name="FluentTypeIcon"
                               Text="&#xE8C8;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <Border x:Name="ColorBox"
                        Width="22" Height="22"
                        CornerRadius="5"
                        BorderThickness="1"
                        BorderBrush="#38808080"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"/>

                <Border x:Name="ImageThumbBorder"
                        Width="24" Height="24"
                        CornerRadius="5"
                        BorderThickness="1"
                        BorderBrush="#30808080"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Visibility="Collapsed"/>
            </Grid>

            <!-- Native Windows 11 2-Line Micro-Pill Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ClipPreviewText"
                           Text="ClipFlyout"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           LineHeight="14"
                           LineStackingStrategy="BlockLineHeight"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ClipMetaText"
                           Text="クリップボード空"
                           FontSize="9.5"
                           FontWeight="Normal"
                           LineHeight="12"
                           LineStackingStrategy="BlockLineHeight"
                           HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Subtle Flyout Up-Chevron Cue -->
            <TextBlock x:Name="ChevronIcon"
                       Grid.Column="2"
                       Text="&#xE70E;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="8.5"
                       Margin="7,0,0,0"
                       VerticalAlignment="Center"
                       Opacity="0.5"/>
        </Grid>
    </Border>
</Window>
