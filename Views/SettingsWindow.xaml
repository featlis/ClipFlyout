<Window x:Class="ClipFlyout.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ClipFlyout.Controls"
        mc:Ignorable="d"
        Title="ClipFlyout Settings"
        Width="840" Height="780"
        MinWidth="700" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/assets/app.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Fluent Tab RadioButton Style -->
        <Style x:Key="FluentTabRadioButton" TargetType="{x:Type RadioButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid Background="Transparent">
                            <Border x:Name="TabBg" CornerRadius="5" Background="Transparent" Margin="1,2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <Border x:Name="Indicator" Height="3" Width="28" CornerRadius="1.5"
                                    Background="{DynamicResource FluentAccentBrush}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBg" Property="Background" Value="#15888888"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round Swatch Style for Color Palette -->
        <Style x:Key="ColorSwatchButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" Width="26" Height="26">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" Opacity="0.25" ShadowDepth="1"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Stroke="#40FFFFFF" StrokeThickness="1" Width="26" Height="26"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Banner (Windows 11 Page Header) -->
        <Border Grid.Row="0" x:Name="HeaderBorder" Padding="32,20,32,16" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Header Brand and Titles -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Image x:Name="HeaderAppIcon" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AppHeaderTitle"
                                   Text="ClipFlyout"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="AppHeaderSubtitle"
                                   Text="クリップボード連携と動作のカスタマイズ"
                                   FontSize="12.5"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Reset Button -->
                <Button Grid.Column="1"
                        x:Name="ResetDefaultsButton"
                        Content="初期値に戻す"
                        Height="32"
                        Padding="16,0"
                        Cursor="Hand"
                        Click="ResetDefaultsButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Segmented Tab Navigation Bar -->
        <Border Grid.Row="1" x:Name="TabHeaderBorder" BorderThickness="0,0,0,1" Padding="32,6,32,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabBtnGeneral" Content="全般" GroupName="SettingsTabs"
                             Style="{StaticResource FluentTabRadioButton}" IsChecked="True"
                             Checked="TabButton_Checked" Tag="0"/>
                <RadioButton x:Name="TabBtnAppearance" Content="外観 &amp; フライアウト" GroupName="SettingsTabs"
                             Style="{StaticResource FluentTabRadioButton}"
                             Checked="TabButton_Checked" Tag="1"/>
                <RadioButton x:Name="TabBtnDetectors" Content="データ型フィルター" GroupName="SettingsTabs"
                             Style="{StaticResource FluentTabRadioButton}"
                             Checked="TabButton_Checked" Tag="2"/>
                <RadioButton x:Name="TabBtnUpdates" Content="更新プログラム" GroupName="SettingsTabs"
                             Style="{StaticResource FluentTabRadioButton}"
                             Checked="TabButton_Checked" Tag="3"/>
                <RadioButton x:Name="TabBtnCredits" Content="情報 &amp; クレジット" GroupName="SettingsTabs"
                             Style="{StaticResource FluentTabRadioButton}"
                             Checked="TabButton_Checked" Tag="4"/>
            </StackPanel>
        </Border>

        <!-- Tab 0: GENERAL CONTENT -->
        <ScrollViewer Grid.Row="2" x:Name="TabContentGeneral" VerticalScrollBarVisibility="Auto" Padding="32,20,32,28" Visibility="Visible">
            <StackPanel MaxWidth="760">
                <TextBlock x:Name="SecGeneralTitle" Text="全般設定" FontSize="13.5" FontWeight="SemiBold" Margin="4,0,0,8"/>
                <Border x:Name="CardGeneral" CornerRadius="8" BorderThickness="1" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- Monitoring Toggle -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#203B82F6" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblMonitoring" Text="クリップボード連携" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescMonitoring" Text="クリップボードの変更を安全にローカル検知し、便利な操作を提案します" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleMonitoring" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep1" Margin="16,0"/>

                        <!-- Windows Startup Toggle -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#208B5CF6" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="🚀" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblStartup" Text="Windows 起動時に自動開始" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescStartup" Text="PC起動時にバックグラウンドでClipFlyoutを開始します" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleStartup" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep2" Margin="16,0"/>

                        <!-- Ignore Password Managers -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#20EF4444" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="🛡️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblIgnorePasswords" Text="パスワード管理ツールのコピーを除外" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescIgnorePasswords" Text="1Password、Bitwarden、KeePass 等からのコピーを検知・保存しません" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleIgnorePasswords" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep3e" Margin="16,0"/>

                        <!-- Recall Hotkey -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#20F59E0B" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="⌨️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblRecallHotkey" Text="リコールショートカット (Alt+Shift+C)" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescRecallHotkey" Text="非表示になった直前のフライアウトをショートカットで再表示します" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleRecallHotkey" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep3" Margin="16,0"/>

                        <!-- Language -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#200EA5E9" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="🌐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblLang" Text="表示言語" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescLang" Text="インターフェースの表示言語を設定します" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="ComboLanguage" Width="170" Height="32" VerticalAlignment="Center"
                                          SelectionChanged="ComboLanguage_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep3a" Margin="16,0"/>

                        <!-- Taskbar Widget Toggle -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#2010B981" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="📌" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblShowWidget" Text="タスクバーウィジェットを表示" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescShowWidget" Text="タスクバー上に最新のコピー内容を小さく直接表示します" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleShowWidget" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep3b" Margin="16,0"/>

                        <!-- Widget Position Preset -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#2010B981" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="📍" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblWidgetPos" Text="ウィジェットの表示位置" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescWidgetPos" Text="タスクバーに沿ったウィジェットの配置場所を選びます" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="ComboWidgetPos" Width="200" Height="32" VerticalAlignment="Center"
                                          SelectionChanged="ComboWidgetPos_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep3c" Margin="16,0"/>

                        <!-- Widget Offset X Slider -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#2010B981" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="↔️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblWidgetOffset" Text="ウィジェット左右微調整" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescWidgetOffset" Text="左右の配置位置をピクセル単位で微調整します" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="SliderWidgetOffset" Width="140" Minimum="-300" Maximum="300" TickFrequency="10" SmallChange="5" LargeChange="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SliderWidgetOffset_ValueChanged"/>
                                    <TextBlock x:Name="TextWidgetOffsetVal" Text="0px" Width="50" TextAlignment="Right" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep3d" Margin="16,0"/>

                        <!-- Widget Text Color Selector -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#2010B981" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="🎨" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblWidgetTextColor" Text="ウィジェットの文字色" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescWidgetTextColor" Text="タスクバーの明るさに合わせた自動検知、または固定色（白・黒）を選択します" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="ComboWidgetTextColor" Width="200" Height="32" VerticalAlignment="Center"
                                          SelectionChanged="ComboWidgetTextColor_SelectionChanged"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Tab 1: APPEARANCE & FLYOUT CONTENT -->
        <ScrollViewer Grid.Row="2" x:Name="TabContentAppearance" VerticalScrollBarVisibility="Auto" Padding="32,20,32,28" Visibility="Collapsed">
            <StackPanel MaxWidth="760">
                <TextBlock x:Name="SecFlyoutTitle" Text="外観 &amp; フライアウト動作" FontSize="13.5" FontWeight="SemiBold" Margin="4,0,0,8"/>
                <Border x:Name="CardFlyout" CornerRadius="8" BorderThickness="1" Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Theme Mode -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#2064748B" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="🌓" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblTheme" Text="アプリテーマ" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescTheme" Text="フライアウトおよび設定画面の外観スタイル (既定: システム準拠)" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="ComboTheme" Width="170" Height="32" VerticalAlignment="Center"
                                          SelectionChanged="ComboTheme_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep4" Margin="16,0"/>

                        <!-- Placement -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#20F97316" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="📐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblPlacement" Text="表示位置" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescPlacement" Text="フライアウトが出現する画面上の位置" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="ComboPlacement" Width="170" Height="32" VerticalAlignment="Center"
                                          SelectionChanged="ComboPlacement_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep5" Margin="16,0"/>

                        <!-- Opacity (Acrylic) -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#2006B6D4" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="🪟" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblOpacity" Text="フライアウトの透明度 (アクリル効果)" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescOpacity" Text="フライアウトのすりガラス背景の不透明度を調整します" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Slider x:Name="SliderOpacity" Width="150" Minimum="20.0" Maximum="100.0" SmallChange="5.0" LargeChange="10.0"
                                            TickFrequency="5.0" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="SliderOpacity_ValueChanged"/>
                                    <TextBlock x:Name="TextOpacityVal" Text="85%" Width="44" TextAlignment="Right" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep5a" Margin="16,0"/>

                        <!-- Auto Hide Timeout -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#20EAB308" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="⏳" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblDuration" Text="自動非表示タイマー" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescDuration" Text="操作がない場合にフライアウトが消えるまでの時間" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Slider x:Name="SliderDuration" Width="150" Minimum="1.5" Maximum="10.0" SmallChange="0.5" LargeChange="1.0"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="SliderDuration_ValueChanged"/>
                                    <TextBlock x:Name="TextDurationVal" Text="3.5s" Width="44" TextAlignment="Right" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep5b" Margin="16,0"/>

                        <!-- Hover Leave Timeout -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#2010B981" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="⏱️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblHoverDuration" Text="マウス離脱後の消滅時間" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescHoverDuration" Text="ホバー解除から消えるまでのカウントダウン時間" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Slider x:Name="SliderHoverDuration" Width="150" Minimum="0.5" Maximum="5.0" SmallChange="0.5" LargeChange="0.5"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="SliderHoverDuration_ValueChanged"/>
                                    <TextBlock x:Name="TextHoverDurationVal" Text="1.5s" Width="44" TextAlignment="Right" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Dedicated RGB Color Picker & Palette Card -->
                <TextBlock x:Name="SecColorPickerTitle" Text="アクセントカラー &amp; カラーピッカー" FontSize="13.5" FontWeight="SemiBold" Margin="4,0,0,8"/>
                <Border x:Name="CardColorPicker" CornerRadius="8" BorderThickness="1" Margin="0,0,0,24" Padding="16,16">
                    <StackPanel>
                        <!-- 1. Preset Color Palette -->
