<Window x:Class="ClipFlyout.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ClipFlyout.Controls"
        mc:Ignorable="d"
        Title="ClipFlyout Settings"
        Width="820" Height="760"
        MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Banner (Windows 11 Page Header) -->
        <Border Grid.Row="0" x:Name="HeaderBorder" Padding="32,24,32,20" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Titles -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="AppHeaderTitle"
                               Text="ClipFlyout"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="AppHeaderSubtitle"
                               Text="クリップボード検出と動作のカスタマイズ"
                               FontSize="12.5"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Reset Button (Windows 11 Standard Secondary Button) -->
                <Button Grid.Column="1"
                        x:Name="ResetDefaultsButton"
                        Content="初期値に戻す"
                        Height="32"
                        Padding="16,0"
                        Cursor="Hand"
                        Click="ResetDefaultsButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Main Scrollable Settings Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,20,32,28">
            <StackPanel MaxWidth="750">

                <!-- 1. GENERAL SECTION -->
                <TextBlock x:Name="SecGeneralTitle" Text="全般" FontSize="13.5" FontWeight="SemiBold" Margin="4,0,0,8"/>
                <Border x:Name="CardGeneral" CornerRadius="8" BorderThickness="1" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- Setting: Monitoring Toggle -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#203B82F6" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="📋" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblMonitoring" Text="クリップボード監視" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescMonitoring" Text="クリップボードの変更を検知してアクションを提案します" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleMonitoring" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep1" Margin="16,0"/>

                        <!-- Setting: Windows Startup Toggle -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#208B5CF6" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="🚀" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblStartup" Text="Windows 起動時に自動開始" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescStartup" Text="PC起動時にバックグラウンドでClipFlyoutを開始します" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleStartup" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep2" Margin="16,0"/>

                        <!-- Setting: Theme Mode -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#2064748B" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="🌓" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblTheme" Text="アプリテーマ" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescTheme" Text="フライアウトおよび設定画面の外観スタイル" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="ComboTheme" Width="170" Height="32" VerticalAlignment="Center"
                                          SelectionChanged="ComboTheme_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep3" Margin="16,0"/>

                        <!-- Setting: Language -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#200EA5E9" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="🌐" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblLang" Text="表示言語" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescLang" Text="インターフェースの表示言語を設定します" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="ComboLanguage" Width="170" Height="32" VerticalAlignment="Center"
                                          SelectionChanged="ComboLanguage_SelectionChanged"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. FLYOUT BEHAVIOR & APPEARANCE SECTION -->
                <TextBlock x:Name="SecFlyoutTitle" Text="フライアウト動作 &amp; 外観" FontSize="13.5" FontWeight="SemiBold" Margin="4,0,0,8"/>
                <Border x:Name="CardFlyout" CornerRadius="8" BorderThickness="1" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- Setting: Placement -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#20F97316" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="📐" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblPlacement" Text="表示位置" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescPlacement" Text="フライアウトが出現する画面上の位置" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="ComboPlacement" Width="170" Height="32" VerticalAlignment="Center"
                                          SelectionChanged="ComboPlacement_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep4" Margin="16,0"/>

                        <!-- Setting: Opacity (Acrylic) -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="210"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#2006B6D4" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="🪟" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblOpacity" Text="背景の透明度 (アクリル効果)" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescOpacity" Text="フライアウトのすりガラス・半透明度を調整します" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Slider x:Name="SliderOpacity" Width="150" Minimum="20.0" Maximum="100.0" SmallChange="5.0" LargeChange="10.0"
                                            TickFrequency="5.0" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="SliderOpacity_ValueChanged"/>
                                    <TextBlock x:Name="TextOpacityVal" Text="85%" Width="44" TextAlignment="Right" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Setting: Accent color -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblAccentColor" Text="アクセントカラー" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescAccentColor" Text="主要な操作ボタンと強調表示の色を選びます" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="ComboAccentColor" Width="170" Height="32" VerticalAlignment="Center"
                                          SelectionChanged="ComboAccentColor_SelectionChanged"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep5" Margin="16,0"/>

                        <!-- Setting: Auto Hide Timeout -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="210"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#20EAB308" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="⏳" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblDuration" Text="自動非表示タイマー" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescDuration" Text="操作がない場合にフライアウトが消えるまでの時間" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Slider x:Name="SliderDuration" Width="150" Minimum="1.5" Maximum="10.0" SmallChange="0.5" LargeChange="1.0"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="SliderDuration_ValueChanged"/>
                                    <TextBlock x:Name="TextDurationVal" Text="3.5s" Width="44" TextAlignment="Right" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep5b" Margin="16,0"/>

                        <!-- Setting: Hover Leave Timeout -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="210"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#2010B981" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="⏱️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblHoverDuration" Text="マウス離脱後の消滅時間" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescHoverDuration" Text="ホバー解除から消えるまでのカウントダウン時間" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Slider x:Name="SliderHoverDuration" Width="150" Minimum="0.5" Maximum="5.0" SmallChange="0.5" LargeChange="0.5"
                                            TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="SliderHoverDuration_ValueChanged"/>
                                    <TextBlock x:Name="TextHoverDurationVal" Text="1.5s" Width="44" TextAlignment="Right" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 3. DATA DETECTORS SECTION -->
                <TextBlock x:Name="SecDetectorsTitle" Text="データ型検出フィルター" FontSize="13.5" FontWeight="SemiBold" Margin="4,0,0,4"/>
                <TextBlock x:Name="SecDetectorsSubtitle" Text="検知してフライアウトを表示するデータ型を選択できます" FontSize="12" Margin="4,0,0,10"/>
                <Border x:Name="CardDetectors" CornerRadius="8" BorderThickness="1" Margin="0,0,0,24">
                    <StackPanel>
                        <!-- Detector: Hex Color -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#208B5CF6" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="🎨" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblDetHex" Text="HEXカラーコード" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescDetHex" Text="#RGB, #RRGGBB などを検知し、色見本プレビューとRGB/HSL変換を提供" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleDetHex" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep6" Margin="16,0"/>

                        <!-- Detector: Unix Timestamp -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#2006B6D4" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="⏱️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblDetTimestamp" Text="Unix タイムスタンプ" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescDetTimestamp" Text="10桁(秒)や13桁(ミリ秒)の数値を検出し、日時プレビューとISO変換を提供" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleDetTimestamp" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep7" Margin="16,0"/>

                        <!-- Detector: JSON -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#203B82F6" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="📦" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblDetJson" Text="JSON テキスト" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescDetJson" Text="JSON オブジェクト・配列を検証し、整形または1行化コピーを提供" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleDetJson" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep8" Margin="16,0"/>

                        <!-- Detector: URL -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#2010B981" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="🌐" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblDetUrl" Text="Web URL" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescDetUrl" Text="Webリンクを検知し、ブラウザ起動やQRコード画像生成を提供" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleDetUrl" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblDetEmail" Text="メールアドレス" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescDetEmail" Text="メール作成、ドメイン・ユーザー名のコピーを提案します" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleDetEmail" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep9" Margin="16,0"/>

                        <!-- Detector: Base64 -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#206366F1" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="🔒" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblDetBase64" Text="Base64 データ" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescDetBase64" Text="Base64文字列やData URIを検出し、テキスト復号や画像展開を提供" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleDetBase64" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep10" Margin="16,0"/>

                        <!-- Detector: Table Data (CSV / TSV) -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#20059669" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="📊" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblDetTable" Text="表データ (CSV / TSV)" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescDetTable" Text="ExcelやTSV/CSVのコピーからMarkdown表やJSON配列への自動変換を提供" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleDetTable" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep11" Margin="16,0"/>

                        <!-- Detector: Code Snippet -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#20D97706" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="💻" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblDetCode" Text="コードスニペット" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescDetCode" Text="プログラミング構文を検知し、インデント調整やHTML特殊文字エスケープを提供" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleDetCode" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep12" Margin="16,0"/>

                        <!-- Detector: Image -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#20DB2777" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="🖼️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblDetImage" Text="画像" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescDetImage" Text="クリップボードの画像を検知し、PNG保存や解像度情報の確認を提供" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleDetImage" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Separator x:Name="Sep13" Margin="16,0"/>

                        <!-- Detector: Plain Text -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#206B7280" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="📝" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblDetText" Text="プレーンテキスト" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescDetText" Text="通常の文字列の前後の余分な空白トリムや文字数・単語数統計を提供" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="2" x:Name="ToggleDetText" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 4. ABOUT SECTION -->
                <TextBlock x:Name="SecAboutTitle" Text="アプリについて" FontSize="13.5" FontWeight="SemiBold" Margin="4,0,0,8"/>
                <Border x:Name="CardAbout" CornerRadius="8" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Local processing information -->
                        <Border x:Name="PrivacyCallout" CornerRadius="6" Padding="14,10" Margin="16,16,16,12">
                            <StackPanel>
                                <TextBlock x:Name="PrivacyTitle" Text="ローカル処理について" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock x:Name="PrivacyDesc" Text="クリップボードの解析はこのPC上で行われます。"
                                           FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Separator x:Name="Sep14" Margin="16,0"/>

                        <!-- Update controls are kept in About so the general
                             page stays focused on clipboard behavior. -->
                        <Border Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblAutoUpdate" Text="自動アップデート" FontSize="13" FontWeight="Medium"/>
                                    <TextBlock x:Name="DescAutoUpdate" Text="GitHub Releases から更新を確認し、安全にインストールします" FontSize="11.5" Margin="0,1.5,0,0"/>
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="1" x:Name="ToggleAutoUpdate" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Padding="16,0,16,12">
                            <Button x:Name="CheckUpdatesButton" Content="更新プログラムを確認" Height="32" HorizontalAlignment="Left" Padding="16,0" Cursor="Hand" Click="CheckUpdatesButton_Click"/>
                        </Border>

                        <Border Padding="16,0,16,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AboutVersion" Text="バージョン: v0.5.0" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Windows 11 Fluent Design Clipboard Utility" FontSize="11.5" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="GithubButton" Content="GitHub" Height="32" Padding="16,0" Cursor="Hand" Click="GithubButton_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
