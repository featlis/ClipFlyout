<Window x:Class="ClipFlyout.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClipFlyout.Controls"
        Title="ClipFlyout 設定"
        Width="860"
        Height="640"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Color Swatch Radio-Style Button -->
        <Style x:Key="AccentSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="OuterRing"
                                    CornerRadius="15"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    Padding="2">
                                <Border x:Name="ColorCircle"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="12"
                                        BorderThickness="1"
                                        BorderBrush="#24000000"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="OuterRing" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Sub-Header -->
        <Style x:Key="SectionGroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="2,14,0,8"/>
        </Style>
    </Window.Resources>

    <!-- Root Mica Shell -->
    <Grid x:Name="RootShell" Background="{DynamicResource AppSurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- LEFT NAVIGATION VIEW (PowerToys / Win11 Settings Style)      -->
        <!-- ============================================================ -->
        <Border Grid.Column="0"
                Background="{DynamicResource NavPaneBackgroundBrush}"
                BorderBrush="{DynamicResource DividerStrokeBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,18,16,16" VerticalAlignment="Center">
                    <Image x:Name="HeaderAppIcon" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ClipFlyout" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="NavVersionText" Text="v2.0.0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Items -->
                <StackPanel Grid.Row="1" Margin="0,2">
                    <RadioButton x:Name="NavGeneral" Style="{DynamicResource FluentNavButtonStyle}" IsChecked="True" Checked="NavItem_Checked" Tag="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavGeneralText" Text="全般" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavFlyout" Style="{DynamicResource FluentNavButtonStyle}" Checked="NavItem_Checked" Tag="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavFlyoutText" Text="外観とフライアウト" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavWidget" Style="{DynamicResource FluentNavButtonStyle}" Checked="NavItem_Checked" Tag="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE75B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavWidgetText" Text="タスクバーウィジェット" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavDetectors" Style="{DynamicResource FluentNavButtonStyle}" Checked="NavItem_Checked" Tag="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavDetectorsText" Text="データ型フィルター" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavHistory" Style="{DynamicResource FluentNavButtonStyle}" Checked="NavItem_Checked" Tag="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavHistoryText" Text="履歴とプライバシー" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavSnippets" Style="{DynamicResource FluentNavButtonStyle}" Checked="NavItem_Checked" Tag="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavSnippetsText" Text="定型文" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom Pinned Nav Item (Updates & About) -->
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <Border Height="1" Background="{DynamicResource DividerStrokeBrush}" Margin="16,4,16,8"/>
                    <RadioButton x:Name="NavAbout" Style="{DynamicResource FluentNavButtonStyle}" Checked="NavItem_Checked" Tag="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Width="24" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NavAboutText" Text="更新と情報" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- RIGHT CONTENT PANE (Flush Scrollbar, 24px Page Margins)      -->
        <!-- ============================================================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Title Header -->
            <TextBlock x:Name="PageHeaderTitle"
                       Grid.Row="0"
                       Text="全般"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="28,22,28,12"/>

            <!-- PAGE 0: GENERAL -->
            <ScrollViewer x:Name="PageGeneral" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,4,28,28">
                    <controls:SettingsCard x:Name="CardMonitoring" IconGlyph="&#xE8C8;" Header="クリップボード連携" Description="">
                        <controls:ToggleSwitch x:Name="ToggleMonitoring" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardStartup" IconGlyph="&#xE7E8;" Header="Windows 起動時に自動開始" Description="">
                        <controls:ToggleSwitch x:Name="ToggleStartup" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardRecallHotkey" IconGlyph="&#xE765;" Header="リコールショートカット (Alt+Shift+C)" Description="">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnRecordHotkey"
                                    Style="{DynamicResource FluentButtonStyle}"
                                    Content="Alt+Shift+C"
                                    MinWidth="112"
                                    Margin="0,0,8,0"
                                    Click="BtnRecordHotkey_Click"/>
                            <Button x:Name="BtnResetHotkey"
                                    Style="{DynamicResource FluentButtonStyle}"
                                    Content="既定に戻す"
                                    Margin="0,0,12,0"
                                    Click="BtnResetHotkey_Click"/>
                            <controls:ToggleSwitch x:Name="ToggleRecallHotkey" Toggled="SettingChanged_Event"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <Border x:Name="HotkeyConflictBanner"
                            Visibility="Collapsed"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,2,0,6"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource StatusWarningBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource StatusWarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="HotkeyConflictText" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <controls:SettingsCard x:Name="CardLanguage" IconGlyph="&#xF2B7;" Header="表示言語" Description="">
                        <ComboBox x:Name="CmbLanguage" Width="190" SelectionChanged="SettingChanged_Event"/>
                    </controls:SettingsCard>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 1: APPEARANCE & FLYOUT -->
            <ScrollViewer x:Name="PageFlyout" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,4,28,28">
                    <controls:SettingsCard x:Name="CardTheme" IconGlyph="&#xE793;" Header="アプリテーマ" Description="">
                        <ComboBox x:Name="CmbTheme" Width="190" SelectionChanged="SettingChanged_Event"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardSystemAccent" IconGlyph="&#xE790;" Header="Windows のアクセントカラーを使用" Description="">
                        <controls:ToggleSwitch x:Name="ToggleSystemAccent" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>

                    <!-- Accent Color Swatches & Custom RGB Card -->
                    <Border x:Name="AccentPickerCard"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,14"
                            Margin="0,0,0,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" Width="20" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="LabelAccentColor" Text="アクセントカラー" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="DescAccentColor" Text="" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border x:Name="CurrentAccentPreview" Grid.Column="2" Width="28" Height="28" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeSecondaryBrush}" Background="#0078D4"/>
                            </Grid>

                            <StackPanel Margin="36,0,0,0">
                                <!-- Preset Swatches -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="SwatchBlue" Style="{DynamicResource AccentSwatchStyle}" Background="#0078D4" Click="AccentSwatch_Click"/>
                                    <Button x:Name="SwatchTeal" Style="{DynamicResource AccentSwatchStyle}" Background="#008575" Click="AccentSwatch_Click"/>
                                    <Button x:Name="SwatchGreen" Style="{DynamicResource AccentSwatchStyle}" Background="#107C10" Click="AccentSwatch_Click"/>
                                    <Button x:Name="SwatchPurple" Style="{DynamicResource AccentSwatchStyle}" Background="#744DA9" Click="AccentSwatch_Click"/>
                                    <Button x:Name="SwatchPink" Style="{DynamicResource AccentSwatchStyle}" Background="#C239B3" Click="AccentSwatch_Click"/>
                                    <Button x:Name="SwatchOrange" Style="{DynamicResource AccentSwatchStyle}" Background="#D83B01" Click="AccentSwatch_Click"/>
                                </StackPanel>

                                <!-- Custom RGB & HEX -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="42"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="LabelColorR" Grid.Row="0" Grid.Column="0" Text="R" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Slider x:Name="SliderColorR" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="RgbSlider_ValueChanged"/>
                                    <TextBlock x:Name="ValColorR" Grid.Row="0" Grid.Column="2" Text="0" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                    <TextBlock x:Name="LabelColorG" Grid.Row="1" Grid.Column="0" Text="G" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Slider x:Name="SliderColorG" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="RgbSlider_ValueChanged"/>
                                    <TextBlock x:Name="ValColorG" Grid.Row="1" Grid.Column="2" Text="120" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                    <TextBlock x:Name="LabelColorB" Grid.Row="2" Grid.Column="0" Text="B" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Slider x:Name="SliderColorB" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="RgbSlider_ValueChanged"/>
                                    <TextBlock x:Name="ValColorB" Grid.Row="2" Grid.Column="2" Text="212" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                    <TextBlock x:Name="LabelColorHex" Grid.Row="3" Grid.Column="0" Text="HEX" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox x:Name="TextHexCode" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{DynamicResource FluentTextBoxStyle}" Width="120" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4,0,0" Text="#0078D4" TextChanged="TextHexCode_TextChanged"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <controls:SettingsCard x:Name="CardPlacement" IconGlyph="&#xE740;" Header="表示位置" Description="">
                        <ComboBox x:Name="CmbPlacement" Width="190" SelectionChanged="SettingChanged_Event"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardOpacity" IconGlyph="&#xE706;" Header="背景の不透明度" Description="">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="SliderOpacity" Width="150" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="DebouncedSlider_ValueChanged"/>
                            <TextBlock x:Name="TxtOpacityVal" Text="85%" Width="44" TextAlignment="Right" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardDuration" IconGlyph="&#xE823;" Header="自動非表示までの時間" Description="">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="SliderDuration" Width="150" Minimum="1.5" Maximum="10.0" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="DebouncedSlider_ValueChanged"/>
                            <TextBlock x:Name="TxtDurationVal" Text="4.0s" Width="44" TextAlignment="Right" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardHoverDuration" IconGlyph="&#xE916;" Header="マウス離脱後の待機時間" Description="">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="SliderHoverDuration" Width="150" Minimum="0.5" Maximum="5.0" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="DebouncedSlider_ValueChanged"/>
                            <TextBlock x:Name="TxtHoverDurationVal" Text="1.5s" Width="44" TextAlignment="Right" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardSuppressFullscreen" IconGlyph="&#xE7F4;" Header="全画面アプリ中は表示しない" Description="">
                        <controls:ToggleSwitch x:Name="ToggleSuppressFullscreen" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 2: TASKBAR WIDGET -->
            <ScrollViewer x:Name="PageWidget" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,4,28,28">
                    <controls:SettingsCard x:Name="CardShowWidget" IconGlyph="&#xE75B;" Header="タスクバーウィジェットを表示" Description="">
                        <controls:ToggleSwitch x:Name="ToggleShowWidget" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>

                    <StackPanel x:Name="WidgetSubSettingsPanel" Margin="0,6,0,0">
                        <controls:SettingsCard x:Name="CardWidgetPosition" IconGlyph="&#xE81D;" Header="配置位置" Description="">
                            <ComboBox x:Name="CmbWidgetPosition" Width="210" SelectionChanged="SettingChanged_Event"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="CardWidgetAutoAlign" IconGlyph="&#xE8A9;" Header="トレイ (^) 左隣に自動吸着" Description="">
                            <controls:ToggleSwitch x:Name="ToggleWidgetAutoAlign" Toggled="SettingChanged_Event"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="CardWidgetMonitor" IconGlyph="&#xE7F4;" Header="表示モニター" Description="">
                            <ComboBox x:Name="CmbWidgetMonitor" Width="210" SelectionChanged="SettingChanged_Event"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="CardWidgetTextColor" IconGlyph="&#xE8D3;" Header="文字色モード" Description="">
                            <ComboBox x:Name="CmbWidgetTextColor" Width="210" SelectionChanged="SettingChanged_Event"/>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="CardWidgetOffset" IconGlyph="&#xE76F;" Header="水平オフセット微調整" Description="">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider x:Name="SliderWidgetOffset" Width="160" Minimum="-400" Maximum="400" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="DebouncedSlider_ValueChanged"/>
                                <TextBlock x:Name="TxtWidgetOffsetVal" Text="0px" Width="48" TextAlignment="Right" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </controls:SettingsCard>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 3: DETECTORS -->
            <ScrollViewer x:Name="PageDetectors" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,0,28,28">
                    <TextBlock x:Name="GroupDetectorsCore" Style="{DynamicResource SectionGroupHeaderStyle}" Margin="2,4,0,8" Text="基本データ型"/>

                    <controls:SettingsCard x:Name="CardDetectHex" IconGlyph="&#xE790;" Header="カラーコード" Description="">
                        <controls:ToggleSwitch x:Name="ToggleDetectHex" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardDetectUrl" IconGlyph="&#xE71B;" Header="Web URL" Description="">
                        <controls:ToggleSwitch x:Name="ToggleDetectUrl" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardDetectFileDrop" IconGlyph="&#xE8B7;" Header="ファイル / フォルダ" Description="">
                        <controls:ToggleSwitch x:Name="ToggleDetectFileDrop" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardDetectImage" IconGlyph="&#xEB9F;" Header="画像" Description="">
                        <controls:ToggleSwitch x:Name="ToggleDetectImage" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardDetectJson" IconGlyph="&#xE943;" Header="JSON" Description="">
                        <controls:ToggleSwitch x:Name="ToggleDetectJson" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardDetectEmail" IconGlyph="&#xE715;" Header="メールアドレス" Description="">
                        <controls:ToggleSwitch x:Name="ToggleDetectEmail" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardDetectTimestamp" IconGlyph="&#xE823;" Header="Unix タイムスタンプ" Description="">
                        <controls:ToggleSwitch x:Name="ToggleDetectTimestamp" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardDetectIsoDate" IconGlyph="&#xE787;" Header="ISO 8601 日時" Description="">
                        <controls:ToggleSwitch x:Name="ToggleDetectIsoDate" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardDetectBase64" IconGlyph="&#xE785;" Header="Base64" Description="">
                        <controls:ToggleSwitch x:Name="ToggleDetectBase64" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardDetectTable" IconGlyph="&#xE8FD;" Header="表データ" Description="">
                        <controls:ToggleSwitch x:Name="ToggleDetectTable" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardDetectCode" IconGlyph="&#xE943;" Header="コードスニペット" Description="">
                        <controls:ToggleSwitch x:Name="ToggleDetectCode" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardDetectPlainText" IconGlyph="&#xE8A5;" Header="プレーンテキスト" Description="">
                        <controls:ToggleSwitch x:Name="ToggleDetectPlainText" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>

                    <TextBlock x:Name="GroupDetectorsTools" Style="{DynamicResource SectionGroupHeaderStyle}" Text="スマート変換・開発者ツール"/>

                    <controls:SettingsCard x:Name="CardCleanUrl" IconGlyph="&#xEA99;" Header="クリーン URL" Description="">
                        <controls:ToggleSwitch x:Name="ToggleCleanUrl" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardCaseConverter" IconGlyph="&#xE8D2;" Header="識別子ケース変換" Description="">
                        <controls:ToggleSwitch x:Name="ToggleCaseConverter" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardJwt" IconGlyph="&#xE8D7;" Header="JWT トークン" Description="">
                        <controls:ToggleSwitch x:Name="ToggleJwt" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardEnableOcr" IconGlyph="&#xE8A5;" Header="画像 OCR" Description="">
                        <controls:ToggleSwitch x:Name="ToggleEnableOcr" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardDetectFilePath" IconGlyph="&#xE8B7;" Header="ファイルパス変換" Description="">
                        <controls:ToggleSwitch x:Name="ToggleDetectFilePath" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardDetectMath" IconGlyph="&#xE8EF;" Header="数式 &amp; 進数変換" Description="">
                        <controls:ToggleSwitch x:Name="ToggleDetectMath" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Name="CardDetectUuid" IconGlyph="&#xE8D7;" Header="UUID / GUID" Description="">
                        <controls:ToggleSwitch x:Name="ToggleDetectUuid" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 4: HISTORY & PRIVACY -->
            <ScrollViewer x:Name="PageHistory" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,4,28,28">
                    <controls:SettingsCard x:Name="CardIgnorePasswordManagers" IconGlyph="&#xE72E;" Header="パスワード管理ツールのコピーを除外" Description="">
                        <controls:ToggleSwitch x:Name="ToggleIgnorePasswordManagers" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardExcludedApps" IconGlyph="&#xE8F8;" Header="除外するアプリ (プロセス名)" Description="">
                        <TextBox x:Name="TxtExcludedApps"
                                 Style="{DynamicResource FluentTextBoxStyle}"
                                 Width="230"
                                 VerticalAlignment="Center"
                                 TextChanged="ExcludedApps_TextChanged"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardPersistHistory" IconGlyph="&#xE74E;" Header="テキスト履歴をローカルに保存" Description="">
                        <controls:ToggleSwitch x:Name="TogglePersistHistory" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardClearHistory" IconGlyph="&#xE74D;" Header="クリップボード履歴をクリア" Description="">
                        <Button x:Name="BtnClearHistory" Style="{DynamicResource FluentButtonStyle}" Content="履歴をクリア" Click="BtnClearHistory_Click"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardLocalProcessing" IconGlyph="&#xE83D;" Header="完全ローカル解析" Description=""/>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 5: UPDATES & ABOUT -->
            <ScrollViewer x:Name="PageAbout" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,0,28,28">
                    <TextBlock x:Name="GroupUpdatesHeader" Style="{DynamicResource SectionGroupHeaderStyle}" Margin="2,4,0,8" Text="更新プログラム"/>

                    <controls:SettingsCard x:Name="CardAutoUpdate" IconGlyph="&#xE895;" Header="自動アップデート確認" Description="">
                        <controls:ToggleSwitch x:Name="ToggleAutoUpdate" Toggled="SettingChanged_Event"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardManualUpdate" IconGlyph="&#xE896;" Header="最新バージョンの手動確認" Description="">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CheckUpdatesButton" Style="{DynamicResource FluentButtonStyle}" Content="更新を確認" Click="CheckUpdatesButton_Click"/>
                            <Button x:Name="BtnInstallUpdateNow" Style="{DynamicResource FluentAccentButtonStyle}" Content="今すぐ更新" Margin="8,0,0,0" Visibility="Collapsed" Click="BtnInstallUpdateNow_Click"/>
                        </StackPanel>
                    </controls:SettingsCard>

                    <Border x:Name="UpdateStatusBanner"
                            Visibility="Collapsed"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,2,0,6"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeBrush}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UpdateStatusGlyph" Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="UpdateStatusText" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="GroupAboutHeader" Style="{DynamicResource SectionGroupHeaderStyle}" Text="アプリについて"/>

                    <!-- Hero App Info Card -->
                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="18,16"
                            Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image x:Name="AboutAppIcon" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ClipFlyout" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="AboutVersionText" Text="バージョン: v2.1.1" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="AboutRuntimeText" Text="ランタイム: .NET 10 / Windows 11 Fluent" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="AboutAuthorText" Text="開発・著作: featlis" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="AboutLicenseText" Text="ライセンス: GPL-3.0-or-later" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <controls:SettingsCard x:Name="CardGithub" IconGlyph="&#xE774;" Header="GitHub リポジトリ" Description="">
                        <Button x:Name="GithubButton" Style="{DynamicResource FluentButtonStyle}" Content="開く" Click="GithubButton_Click"/>
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="CardReset" IconGlyph="&#xE777;" Header="設定を初期値に戻す" Description="">
                        <Button x:Name="ResetDefaultsButton" Style="{DynamicResource FluentButtonStyle}" Content="初期値に戻す" Click="ResetDefaultsButton_Click"/>
                    </controls:SettingsCard>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 6: SNIPPETS -->
            <ScrollViewer x:Name="PageSnippets" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,0,28,28">
                    <TextBlock x:Name="LblSnippetEditorHeader" Style="{DynamicResource SectionGroupHeaderStyle}" Margin="2,4,0,8" Text="定型文の追加 / 編集"/>

                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBox x:Name="TxtSnippetTitle"
                                         Style="{DynamicResource FluentTextBoxStyle}"
                                         TextChanged="TxtSnippetField_TextChanged"/>
                                <TextBlock x:Name="TxtSnippetTitlePlaceholder"
                                           Text="タイトル（省略時は本文から自動生成）"
                                           FontSize="12.5"
                                           Margin="12,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </Grid>

                            <Grid>
                                <TextBox x:Name="TxtSnippetContent"
                                         Style="{DynamicResource FluentTextBoxStyle}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="82"
                                         VerticalContentAlignment="Top"
                                         Padding="10,8"
                                         VerticalScrollBarVisibility="Auto"
                                         TextChanged="TxtSnippetField_TextChanged"/>
                                <TextBlock x:Name="TxtSnippetContentPlaceholder"
                                           Text="よく使うテキスト・コマンド・署名などを入力..."
                                           FontSize="12.5"
                                           Margin="12,9,12,0"
                                           VerticalAlignment="Top"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button x:Name="BtnCancelSnippetEdit"
                                        Style="{DynamicResource FluentButtonStyle}"
                                        Content="キャンセル"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"
                                        Click="BtnCancelSnippetEdit_Click"/>
                                <Button x:Name="BtnSaveSnippet"
                                        Style="{DynamicResource FluentAccentButtonStyle}"
                                        Content="追加"
                                        MinWidth="84"
                                        Click="BtnSaveSnippet_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="LblSavedSnippetsHeader" Style="{DynamicResource SectionGroupHeaderStyle}" Text="保存済みの定型文 (0)"/>
                    <TextBlock x:Name="TxtNoSnippetsSettings"
                               Text="定型文はまだありません"
                               FontSize="12.5"
                               Margin="2,4,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Visibility="Collapsed"/>

                    <ItemsControl x:Name="SnippetsSettingsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,10"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Preview}"
                                                       FontSize="12"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{DynamicResource FluentButtonStyle}"
                                                    Content="{Binding CopyLabel}"
                                                    Height="30"
                                                    Padding="10,0"
                                                    Margin="0,0,6,0"
                                                    Tag="{Binding Item}"
                                                    Click="SnippetRowCopy_Click"/>
                                            <Button Style="{DynamicResource FluentButtonStyle}"
                                                    Content="{Binding EditLabel}"
                                                    Height="30"
                                                    Padding="10,0"
                                                    Margin="0,0,6,0"
                                                    Tag="{Binding Item}"
                                                    Click="SnippetRowEdit_Click"/>
                                            <Button Style="{DynamicResource FluentButtonStyle}"
                                                    Content="{Binding DeleteLabel}"
                                                    Height="30"
                                                    Padding="10,0"
                                                    Tag="{Binding Item}"
                                                    Click="SnippetRowDelete_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
